{
  "name": "harmony-sign-suite",
  "version": "0.3.0",
  "description": "HarmonyOS signing & publishing automation toolchain — one command from unsigned HAP to AGC-ready package, with pre-flight checks and human-readable diagnostics.",
  "keywords": [
    "harmonyos",
    "openharmony",
    "hap",
    "signing",
    "appgallery",
    "devtools"
  ],
  "license": "MIT",
  "author": "hss contributors",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "hss": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "verify": "tsc --noEmit && vitest run",
    "prepack": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc --noEmit && vitest run && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@peculiar/x509": "^1.12.3",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
